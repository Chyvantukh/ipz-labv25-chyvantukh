<Window x:Class="ClientApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart House - Панель керування" Height="480" Width="720"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9">

    <!-- Основна сітка вікна -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Дистанційне керування пристроями" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
        </DockPanel>

        <!-- Таблиця пристроїв з підтримкою Data Binding -->
        <DataGrid Grid.Row="1" x:Name="DgDevices" AutoGenerateColumns="False" CanUserAddRows="False" 
                  ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                  Background="White" RowHeight="35" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Назва пристрою" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="110"/>
                <DataGridTextColumn Header="Стан" Binding="{Binding StatusText}" Width="150"/>
                <DataGridTextColumn Header="Параметри" Binding="{Binding StatusDetails}" Width="140"/>
                <DataGridTextColumn Header="Останнє оновлення" Binding="{Binding LastUpdated}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Нижній блок кнопок із виправленими відступами -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Переключити стан (Ув/Вимк)" Click="BtnToggle_Click" Style="{StaticResource MyButtonStyle}" Margin="0,0,10,0"/>
            <Button Content="Змінити параметр" Click="BtnEdit_Click" Style="{StaticResource MyButtonStyle}" Margin="0,0,10,0"/>
            <Button Content="Вихід" Click="BtnLogout_Click" Style="{StaticResource MyButtonStyle}" Background="#EF4444" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>