<Window x:Class="ClientApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart House - Панель керування" Height="510" Width="860"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка вікна з відображенням активного користувача -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Дистанційне керування пристроями" FontSize="18" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Left"/>
            <TextBlock x:Name="TxtCurrentUser" Text="Користувач: admin" FontSize="13" FontWeight="SemiBold" Foreground="#334155"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Таблиця пристроїв із підтримкою Data Binding -->
        <DataGrid Grid.Row="1" x:Name="DgDevices" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  ItemsSource="{Binding Devices}"
                  Background="White" RowHeight="34" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                <DataGridTextColumn Header="Назва пристрою" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="125"/>
                <DataGridTextColumn Header="Стан" Binding="{Binding StatusText}" Width="155"/>
                <DataGridTextColumn Header="Параметри" Binding="{Binding StatusDetails}" Width="150"/>
                <DataGridTextColumn Header="Останнє оновлення" Binding="{Binding LastUpdated}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Рядок статусу мережевої взаємодії -->
        <TextBlock Grid.Row="2" x:Name="TxtStatusBar" Text="Статус: Підключено до TCP-сервера (127.0.0.1:8888)"
                   FontSize="12" Foreground="#475569" Margin="0,10,0,0"/>

        <!-- Нижня панель керування -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Переключити стан" Click="BtnToggle_Click" Style="{StaticResource MyButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Змінити параметр" Click="BtnEdit_Click" Style="{StaticResource MyButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Додати пристрій" Click="BtnAdd_Click" Style="{StaticResource MyButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Видалити" Click="BtnDelete_Click" Style="{StaticResource MyButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Оновити" Click="BtnRefresh_Click" Style="{StaticResource MyButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Вихід" Click="BtnLogout_Click" Style="{StaticResource MyButtonStyle}" Background="#EF4444" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>