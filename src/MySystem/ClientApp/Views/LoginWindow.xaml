<Window x:Class="ClientApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart House - Авторизація" Height="360" Width="380"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">

    <!-- Контейнер форми авторизації -->
    <StackPanel Margin="30" VerticalAlignment="Center">
        <TextBlock Text="Smart House System" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <!-- Поле логіна -->
        <TextBlock Text="Логін:" Style="{StaticResource MyLabelStyle}" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtUsername" Style="{StaticResource MyInputStyle}" Height="30" Margin="0,0,0,12"/>

        <!-- Поле пароля -->
        <TextBlock Text="Пароль:" Style="{StaticResource MyLabelStyle}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TxtPassword" Style="{StaticResource MyInputStyle}" Height="30" Margin="0,0,0,20"/>

        <!-- Кнопки входу та переходу до реєстрації -->
        <Button Content="Увійти" Click="BtnLogin_Click" Style="{StaticResource MyButtonStyle}" IsDefault="True" Margin="0,0,0,10"/>
        <Button Content="Реєстрація" Click="BtnOpenRegister_Click" Style="{StaticResource MyButtonStyle}"/>
    </StackPanel>
</Window>